msgid "Token"
msgstr "Jeton"

#. Viewer: dialog.save
#: kvm_viewer_i18n.rsviewerdialogsave
msgid "Save"
msgstr "Enregistrer"

#. Viewer: dialog.cancel
#: kvm_viewer_i18n.rsviewerdialogcancel
msgid "Cancel"
msgstr "Annuler"

#. Viewer: dialog.lock_warning
#: kvm_viewer_i18n.rsviewerdialoglockwarning
msgid "Lock remote Windows session? You may lose remote control until someone unlocks it locally."
msgstr "Verrouiller la session Windows distante ? Vous risquez de perdre le contrôle jusqu'à son déverrouillage local."

#. Viewer: dialog.invalid_connection
#: kvm_viewer_i18n.rsviewerdialoginvalidconnection
msgid "Enter a host, a valid port, and an ASCII token without spaces (16..256 characters)."
msgstr "Saisissez un hôte, un port valide et un jeton ASCII sans espace (16 à 256 caractères)."

#. Viewer: dialog.text_title
#: kvm_viewer_i18n.rsviewerdialogtexttitle
msgid "Text input"
msgstr "Saisie de texte"

#. Viewer: dialog.text_message
#: kvm_viewer_i18n.rsviewerdialogtextmessage
msgid "Text entered using your input method (256 characters max)"
msgstr "Texte saisi avec votre méthode de saisie (256 caractères maximum)"

#. Viewer: status.initial
#: kvm_viewer_i18n.rsviewerstatusinitial
msgid "Disconnected | fit to window"
msgstr "Déconnecté | adapté à la fenêtre"

#. Viewer: status.language_changed
#: kvm_viewer_i18n.rsviewerstatuslanguagechanged
msgid "Viewer language: English"
msgstr "Langue du Viewer : français"

#. Viewer: status.monitor_required
#: kvm_viewer_i18n.rsviewerstatusmonitorrequired
msgid "At least one remote monitor must remain visible."
msgstr "Au moins un écran distant doit rester visible."

#. Viewer: status.clipboard_direction
#: kvm_viewer_i18n.rsviewerstatusclipboarddirection
msgid "Clipboard: local -> remote=%s; remote -> local=%s"
msgstr "Presse-papiers : local -> distant=%s ; distant -> local=%s"

#. Viewer: status.tls_required
#: kvm_viewer_i18n.rsviewerstatustlsrequired
msgid "TLS is required outside loopback. Use --allow-insecure only with a trusted tunnel/VPN."
msgstr "TLS est obligatoire hors de la machine locale. Utilisez --allow-insecure uniquement via un tunnel ou VPN fiable."

#. Viewer: status.connecting
#: kvm_viewer_i18n.rsviewerstatusconnecting
msgid "Connecting..."
msgstr "Connexion en cours..."

#. Viewer: status.ca_missing
#: kvm_viewer_i18n.rsviewerstatuscamissing
msgid "TLS CA file not found: %s"
msgstr "Fichier CA TLS introuvable : %s"

#. Viewer: status.invalid_ws
#: kvm_viewer_i18n.rsviewerstatusinvalidws
msgid "Invalid WebSocket address."
msgstr "Adresse WebSocket invalide."

#. Viewer: status.socket_open
#: kvm_viewer_i18n.rsviewerstatussocketopen
msgid "Socket open; authenticating..."
msgstr "Socket ouvert ; authentification en cours..."

#. Viewer: status.connect_failed
#: kvm_viewer_i18n.rsviewerstatusconnectfailed
msgid "Connection failed: %s"
msgstr "Échec de connexion : %s"

#. Viewer: status.disconnected
#: kvm_viewer_i18n.rsviewerstatusdisconnected
msgid "Disconnected"
msgstr "Déconnecté"

#. Viewer: status.control_request
#: kvm_viewer_i18n.rsviewerstatuscontrolrequest
msgid "Requesting exclusive control from server..."
msgstr "Demande de contrôle exclusif au serveur..."

#. Viewer: status.control_released
#: kvm_viewer_i18n.rsviewerstatuscontrolreleased
msgid "View only: control released."
msgstr "Lecture seule : contrôle libéré."

#. Viewer: status.control_revoked
#: kvm_viewer_i18n.rsviewerstatuscontrolrevoked
msgid "%s. Control revoked."
msgstr "%s. Contrôle révoqué."

#. Viewer: status.desktop_available
#: kvm_viewer_i18n.rsviewerstatusdesktopavailable
msgid "Desktop available. Request control again if needed."
msgstr "Bureau disponible. Redemandez le contrôle si nécessaire."

#. Viewer: status.text_rejected
#: kvm_viewer_i18n.rsviewerstatustextrejected
msgid "Text rejected: limit 256 Unicode code points / 1024 bytes, no control characters."
msgstr "Texte refusé : limite de 256 points de code Unicode / 1 024 octets, aucun caractère de contrôle."

#. Viewer: status.remote_desktop
#: kvm_viewer_i18n.rsviewerstatusremotedesktop
msgid "Remote desktop: %d x %d | video worker"
msgstr "Bureau distant : %d x %d | traitement vidéo"

#. Viewer: status.send_interrupted
#: kvm_viewer_i18n.rsviewerstatussendinterrupted
msgid "Network send interrupted: input will not be replayed."
msgstr "Envoi réseau interrompu : les saisies ne seront pas retransmises."

#. Viewer: status.connected_control
#: kvm_viewer_i18n.rsviewerstatusconnectedcontrol
msgid "Connected | control available."
msgstr "Connecté | contrôle disponible."

#. Viewer: status.connected_view
#: kvm_viewer_i18n.rsviewerstatusconnectedview
msgid "Connected | view only."
msgstr "Connecté | lecture seule."

#. Viewer: status.control_granted
#: kvm_viewer_i18n.rsviewerstatuscontrolgranted
msgid "EXCLUSIVE control granted: click inside the desktop."
msgstr "Contrôle EXCLUSIF accordé : cliquez dans le bureau."

#. Viewer: status.control_busy
#: kvm_viewer_i18n.rsviewerstatuscontrolbusy
msgid "Another client currently controls the desktop."
msgstr "Un autre client contrôle actuellement le bureau."

#. Viewer: status.sas_requested
#: kvm_viewer_i18n.rsviewerstatussasrequested
msgid "Ctrl+Alt+Del requested. Windows may block it (service/uiAccess and SAS policy required)."
msgstr "Ctrl+Alt+Suppr demandé. Windows peut le bloquer (service/uiAccess et stratégie SAS nécessaires)."

#. Viewer: status.sas_unavailable
#: kvm_viewer_i18n.rsviewerstatussasunavailable
msgid "Ctrl+Alt+Del unavailable: remote host is not Windows or lacks sas.dll."
msgstr "Ctrl+Alt+Suppr indisponible : hôte non Windows ou sas.dll absent."

#. Viewer: status.sas_denied
#: kvm_viewer_i18n.rsviewerstatussasdenied
msgid "Ctrl+Alt+Del denied: exclusive control or active desktop required."
msgstr "Ctrl+Alt+Suppr refusé : contrôle exclusif ou bureau actif requis."

#. Viewer: status.sas_privileges
#: kvm_viewer_i18n.rsviewerstatussasprivileges
msgid "Ctrl+Alt+Del not permitted: the remote host requires a Windows service or signed uiAccess application and SAS policy."
msgstr "Ctrl+Alt+Suppr impossible : le serveur distant doit fonctionner comme service Windows ou application uiAccess signée, avec la stratégie SAS autorisée."

#. Viewer: status.lock_requested
#: kvm_viewer_i18n.rsviewerstatuslockrequested
msgid "Remote Windows session lock requested."
msgstr "Verrouillage de la session Windows distante demandé."

#. Viewer: status.lock_unavailable
#: kvm_viewer_i18n.rsviewerstatuslockunavailable
msgid "Lock unavailable: the remote host is not Windows."
msgstr "Verrouillage indisponible : le serveur distant n’utilise pas Windows."

#. Viewer: status.lock_failed
#: kvm_viewer_i18n.rsviewerstatuslockfailed
msgid "Remote Windows session could not be locked (interactive session required)."
msgstr "Impossible de verrouiller la session Windows distante (session interactive requise)."

#. Viewer: status.lock_denied
#: kvm_viewer_i18n.rsviewerstatuslockdenied
msgid "Lock denied: exclusive control or active desktop required."
msgstr "Verrouillage refusé : contrôle exclusif et bureau actif requis."

#. Viewer: status.input_unsupported
#: kvm_viewer_i18n.rsviewerstatusinputunsupported
msgid "Input unsupported or rejected by the remote system. Text may be incomplete."
msgstr "Saisie non prise en charge ou refusée par le système distant. Le texte peut être incomplet."

#. Viewer: status.auth_denied
#: kvm_viewer_i18n.rsviewerstatusauthdenied
msgid "Authentication refused"
msgstr "Authentification refusée"

#. Viewer: status.client_limit
#: kvm_viewer_i18n.rsviewerstatusclientlimit
msgid "Maximum number of clients reached"
msgstr "Nombre maximal de clients atteint"

#. Viewer: status.timeout
#: kvm_viewer_i18n.rsviewerstatustimeout
msgid "Session ended: server reported a timeout"
msgstr "Session terminée : le serveur signale un délai d'attente dépassé"

#. Viewer: status.protocol_error
#: kvm_viewer_i18n.rsviewerstatusprotocolerror
msgid "Server reported a protocol error"
msgstr "Le serveur signale une erreur de protocole"

#. Viewer: status.local_receive
#: kvm_viewer_i18n.rsviewerstatuslocalreceive
msgid "LOCAL receive error: %s"
msgstr "Erreur de réception LOCALE : %s"

#. Viewer: status.socket_closed
#: kvm_viewer_i18n.rsviewerstatussocketclosed
msgid "WebSocket closed: %s (check origin)"
msgstr "WebSocket fermé : %s (origine à vérifier)"

#. Viewer: status.video_error
#: kvm_viewer_i18n.rsviewerstatusvideoerror
msgid "Video error: %s"
msgstr "Erreur vidéo : %s"

#. Viewer: status.invalid_session
#: kvm_viewer_i18n.rsviewerstatusinvalidsession
msgid "Invalid session state"
msgstr "État de session invalide"

#. Viewer: status.invalid_ack
#: kvm_viewer_i18n.rsviewerstatusinvalidack
msgid "Invalid input acknowledgment"
msgstr "Accusé de réception de saisie invalide"

#. Viewer: status.input_desync
#: kvm_viewer_i18n.rsviewerstatusinputdesync
msgid "Input sequence out of sync"
msgstr "Séquence de saisie désynchronisée"

#. Viewer: status.input_partial
#: kvm_viewer_i18n.rsviewerstatusinputpartial
msgid "Input rejected/partial (%d, %d code points)"
msgstr "Saisie refusée/partielle (%d, %d points de code)"

#. Viewer: status.display_failed
#: kvm_viewer_i18n.rsviewerstatusdisplayfailed
msgid "Display failed: %s"
msgstr "Échec d'affichage : %s"

#. Viewer: status.input_ack_missing
#: kvm_viewer_i18n.rsviewerstatusinputackmissing
msgid "Input acknowledgment missing: no retransmission"
msgstr "Accusé de réception de saisie manquant : aucune retransmission"

#. Viewer: status.input_blocked
#: kvm_viewer_i18n.rsviewerstatusinputblocked
msgid "Invalid local input blocked before sending."
msgstr "Saisie locale invalide bloquée avant l'envoi."

#. Viewer: status.input_queue_full
#: kvm_viewer_i18n.rsviewerstatusinputqueuefull
msgid "Input queue full: unsent events discarded, keys released."
msgstr "File de saisie saturée : événements non envoyés écartés et touches relâchées."

#. Viewer: status.keyboard_physical
#: kvm_viewer_i18n.rsviewerstatuskeyboardphysical
msgid "Physical keys: the remote desktop keyboard layout and input methods apply."
msgstr "Touches physiques : la disposition du clavier et la méthode de saisie distantes s'appliquent."

#. Viewer: status.keyboard_auto
#: kvm_viewer_i18n.rsviewerstatuskeyboardauto
msgid "Automatic mode: locally composed Unicode text; shortcuts and special keys sent separately."
msgstr "Mode automatique : texte Unicode composé localement ; raccourcis et touches spéciales envoyés séparément."

#. Viewer: view.waiting
#: kvm_viewer_i18n.rsviewerviewwaiting
msgid "Waiting for remote desktop..."
msgstr "En attente du bureau distant..."

#. Viewer: session.active
#: kvm_viewer_i18n.rsviewersessionactive
msgid "Session active"
msgstr "Session active"

#. Viewer: session.locked
#: kvm_viewer_i18n.rsviewersessionlocked
msgid "Session locked"
msgstr "Session verrouillée"

#. Viewer: session.inactive
#: kvm_viewer_i18n.rsviewersessioninactive
msgid "Session inactive/disconnected"
msgstr "Session inactive/déconnectée"

#. Viewer: session.changed
#: kvm_viewer_i18n.rsviewersessionchanged
msgid "Session changed: restart the server in the intended session"
msgstr "Session modifiée : relancez le serveur dans la session souhaitée"

#. Viewer: session.capture_lost
#: kvm_viewer_i18n.rsviewersessioncapturelost
msgid "Capture unavailable"
msgstr "Capture indisponible"

#. Viewer: session.unknown
#: kvm_viewer_i18n.rsviewersessionunknown
msgid "Unknown session state (sharing suspended)"
msgstr "État de session inconnu (partage suspendu)"

#. Viewer: dialog.arguments_title
#: kvm_viewer_i18n.rsviewerdialogargumentstitle
msgid "Invalid LazDesk parameters"
msgstr "Paramètres LazDesk incorrects"

#. Viewer: dialog.help_title
#: kvm_viewer_i18n.rsviewerdialoghelptitle
msgid "LazDeskClient - help"
msgstr "LazDeskClient - aide"

