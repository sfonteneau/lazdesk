<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="5">
    <Name Value="LazDeskViewer"/>
    <Author Value="LazDesk"/>
    <CompilerOptions>
      <Version Value="11"/>
      <SearchPaths>
        <OtherUnitFiles Value="../client;../shared"/>
        <UnitOutputDirectory Value="lib/$(TargetCPU)-$(TargetOS)"/>
      </SearchPaths>
      <CodeGeneration>
        <SmartLinkUnit Value="True"/>
        <Optimizations>
          <OptimizationLevel Value="3"/>
        </Optimizations>
      </CodeGeneration>
      <Linking>
        <Debugging>
          <DebugInfoType Value="dsDwarf3"/>
        </Debugging>
      </Linking>
    </CompilerOptions>
    <Description Value="LazDesk reusable LCL viewer window or frame (WebSocket)"/>
    <License Value="Refer to project README and dependencies"/>
    <Version Major="1" Minor="1"/>
    <Files>
      <Item>
        <Filename Value="../client/kvm_viewer_frame.pas"/>
        <UnitName Value="kvm_viewer_frame"/>
      </Item>
      <Item>
        <Filename Value="../client/kvm_view_form.pas"/>
        <UnitName Value="kvm_view_form"/>
      </Item>
      <Item>
        <Filename Value="../client/kvm_viewer_window.pas"/>
        <UnitName Value="kvm_viewer_window"/>
      </Item>
      <Item>
        <Filename Value="../client/kvm_viewer_i18n.pas"/>
        <UnitName Value="kvm_viewer_i18n"/>
      </Item>
      <Item>
        <Filename Value="../shared/kvm_cli.pas"/>
        <UnitName Value="kvm_cli"/>
      </Item>
    </Files>
    <RequiredPkgs>
      <Item>
        <PackageName Value="LCL"/>
      </Item>
      <Item>
        <PackageName Value="mormot2"/>
      </Item>
    </RequiredPkgs>
    <UsageOptions>
      <IncludePath Value="$(PkgIncPath)"/>
      <UnitPath Value="$(PkgOutDir)"/>
    </UsageOptions>
    <PublishOptions>
      <Version Value="2"/>
    </PublishOptions>
  </Package>
</CONFIG>
