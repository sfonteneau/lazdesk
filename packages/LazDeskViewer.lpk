<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="5">
    <Name Value="LazDeskViewer"/>
    <Type Value="RunTime"/>
    <Version Major="1" Minor="1"/>
    <Author Value="LazDesk"/>
    <Description Value="LazDesk reusable LCL viewer window or frame (WebSocket)"/>
    <License Value="Refer to project README and dependencies"/>
    <RequiredPkgs>
      <Item1><PackageName Value="mormot2"/></Item1>
      <Item2><PackageName Value="LCL"/></Item2>
    </RequiredPkgs>
    <Files Count="4">
      <Item1>
        <Filename Value="../client/kvm_viewer_frame.pas"/>
        <UnitName Value="kvm_viewer_frame"/>
      </Item1>
      <Item2>
        <Filename Value="../client/kvm_view_form.pas"/>
        <UnitName Value="kvm_view_form"/>
      </Item2>
      <Item3>
        <Filename Value="../client/kvm_viewer_window.pas"/>
        <UnitName Value="kvm_viewer_window"/>
      </Item3>
      <Item4>
        <Filename Value="../client/kvm_viewer_i18n.pas"/>
        <UnitName Value="kvm_viewer_i18n"/>
      </Item4>
    </Files>
  </Package>
  <CompilerOptions>
    <Version Value="11"/>
    <SearchPaths>
      <OtherUnitFiles Value="../client;../shared"/>
      <UnitOutputDirectory Value="lib/$(TargetCPU)-$(TargetOS)"/>
    </SearchPaths>
    <CodeGeneration>
      <Optimizations><OptimizationLevel Value="2"/></Optimizations>
    </CodeGeneration>
  </CompilerOptions>
</CONFIG>
